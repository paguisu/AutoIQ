# =========================
# AutoIQ - Git ignore
# =========================

# --- Entornos / editor ---
.vscode/
.idea/
*.swp
*.swo

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- Variables de entorno (credenciales) ---
.env
.env.*
!.env.example

# --- Sistema ---
.DS_Store
Thumbs.db

# --- Salidas / datos generados por la app (NO versionar) ---
data/archivos_subidos/
data/combinados/
data/procesos/
data/catalogos/
frontend/descargas/

# Debug/outputs ATM (NO subir)
data/atm/debug/
data/atm/res/
data/atm/rr/

# Cabeceras persistidas localmente (si usás archivo)
data/cabeceras/cabeceras.json

# --- Documentación pesada / adjuntos ---
web_services/
web_servicies/

# --- Binarios grandes (evitar que el repo explote) ---
*.zip
*.7z
*.rar
*.pdf
*.pptx

# Excel / CSV grandes (si querés versionar fixtures chicos, ver abajo)
*.xlsx
*.xls
*.csv

# (Opcional) permitir fixtures versionadas en tests:
!backend/tests/fixtures/**/*.xlsx
!backend/tests/fixtures/**/*.csv

# Documentos locales
*.docx

# otros
Vera/

# --- Entorno local de desarrollo / Codex ---
.codex-preview/
venv/
tmp/
output/
outputs/
tools/__pycache__/
*.cer
*.pem

# --- Estado operativo local ---
data/historial_detalle/
data/commercial_conditions/*.log.jsonl
data/system/*.log.jsonl
data/system/session.json
data/system/historial_ownership.json
backend/data/system/session.json
data/tmp-*.json

# --- Diagnosticos y scripts descartables de raiz ---
tmp-*.json
tmp-*.js
tmp-*.ps1
tmp-*.html
recognized_codes*.json
recognized_codes*.txt
